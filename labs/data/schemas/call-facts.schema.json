{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sp7412/onboarding/labs/data/schemas/call-facts.schema.json",
  "title": "CallFacts v1",
  "description": "Structured facts a voice agent extracts from one call (labs/stlab/minimax.py). Every field carries a confidence and the caller's words that support it.",
  "type": "object",
  "required": ["schema_version", "call_id", "fields", "conflicts"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "call-facts-v1"},
    "call_id": {"type": "string", "pattern": "^call-[0-9]{4}$"},
    "conflicts": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "fields": {
      "type": "object",
      "required": ["intent", "job_type", "urgency", "emergency", "bookable", "caller_sentiment",
                   "replacement_interest", "membership", "price_shopper", "injection_attempt"],
      "additionalProperties": false,
      "properties": {
        "intent": {"allOf": [{"$ref": "#/$defs/fact"}, {"properties": {"value": {"enum": ["book_service", "price_quote", "reschedule", "cancel", "out_of_area", "emergency", "unknown", "spam"]}}}]},
        "job_type": {"allOf": [{"$ref": "#/$defs/fact"}, {"properties": {"value": {"enum": ["ac_repair", "electrical_issue", "furnace_repair", "hvac_tuneup", "leak_repair", "none", "water_heater"]}}}]},
        "urgency": {"allOf": [{"$ref": "#/$defs/fact"}, {"properties": {"value": {"enum": ["emergency", "same_day", "soon", "routine", "none"]}}}]},
        "caller_sentiment": {"allOf": [{"$ref": "#/$defs/fact"}, {"properties": {"value": {"enum": ["positive", "neutral", "frustrated", "angry"]}}}]},
        "emergency": {"$ref": "#/$defs/boolean_fact"},
        "bookable": {"$ref": "#/$defs/boolean_fact"},
        "replacement_interest": {"$ref": "#/$defs/boolean_fact"},
        "membership": {"$ref": "#/$defs/boolean_fact"},
        "price_shopper": {"$ref": "#/$defs/boolean_fact"},
        "injection_attempt": {"$ref": "#/$defs/boolean_fact"}
      }
    }
  },
  "$defs": {
    "fact": {
      "type": "object",
      "required": ["value", "confidence", "evidence"],
      "additionalProperties": false,
      "properties": {
        "value": {},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["speaker", "quote"],
            "additionalProperties": false,
            "properties": {
              "speaker": {"enum": ["caller", "agent"]},
              "quote": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "boolean_fact": {"allOf": [{"$ref": "#/$defs/fact"}, {"properties": {"value": {"type": "boolean"}}}]}
  }
}
