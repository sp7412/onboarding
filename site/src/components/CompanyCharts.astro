---
const quarters = [
  { label: "Q1 FY26", value: 17.7 },
  { label: "Q2 FY26", value: 22.9 },
  { label: "Q3 FY26", value: 21.7 },
  { label: "Q4 FY26", value: 19.8 },
  { label: "Q1 FY27", value: 21.7 },
  { label: "Q2 FY27", value: 26.8 },
];
const chart = { left: 54, top: 24, bottom: 190, width: 720, max: 30 };
const barWidth = 54;
const step = 112;
const barX = (i: number) => chart.left + 18 + i * step;
const barHeight = (v: number) => (v / chart.max) * (chart.bottom - chart.top);
import marketData from "../data/ttan-vwap.json";
type PriceRow = { date: string; close: number; volume: number; rollingCloseVwap: number };
type QuarterRow = { label: string; quarter: number; firstDate: string; lastDate: string; sessions: number; volume: number; volumeWeightedClose: number };
const dailyPrices = marketData.data as PriceRow[];
const quarterlyPrices = (marketData as typeof marketData & { quarterlyClosingVwap?: QuarterRow[] }).quarterlyClosingVwap ?? [];
const recentPrices = dailyPrices.slice(-10);
const monthNames = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
const monthTicks = dailyPrices.map((p, i) => ({ p, i })).filter(({ p, i }) =>
  i === 0 || p.date.slice(0, 7) !== (dailyPrices[i - 1]?.date ?? "").slice(0, 7)
).map(({ p, i }) => ({ index: i, label: (monthNames[Number(p.date.slice(5, 7)) - 1] ?? "???") + " '" + p.date.slice(2, 4) }));
const annualPlot = { left: 54, top: 34, bottom: 218, right: 718 };
const annualX = (i: number, count: number) => count <= 1 ? 386 :
  annualPlot.left + i * ((annualPlot.right - annualPlot.left) / (count - 1));
const annualY = (value: number, min: number, max: number) =>
  annualPlot.bottom - ((value - min) / (max - min)) * (annualPlot.bottom - annualPlot.top);
const getRange = (values: number[], fallbackMin: number, fallbackMax: number): [number, number] => {
  if (!values.length) return [fallbackMin, fallbackMax];
  const low = Math.min(...values), high = Math.max(...values);
  const pad = Math.max(1, (high - low) * 0.08);
  return [Math.floor((low - pad) / 5) * 5, Math.ceil((high + pad) / 5) * 5];
};
const [priceMin, priceMax] = getRange(dailyPrices.map((p) => p.close), 50, 125);
const priceLine = dailyPrices.map((p, i) => annualX(i, dailyPrices.length) + "," + annualY(p.close, priceMin, priceMax)).join(" ");
const inset = { left: 494, top: 278, right: 724, bottom: 352 };
const insetX = (i: number) => recentPrices.length <= 1 ? 609 :
  inset.left + i * ((inset.right - inset.left) / (recentPrices.length - 1));
const insetValues = recentPrices.map((p) => p.close);
const [insetMin, insetMax] = getRange(insetValues, 50, 100);
const insetY = (value: number) => inset.bottom - ((value - insetMin) / (insetMax - insetMin || 1)) * (inset.bottom - inset.top);
const recentPriceLine = recentPrices.map((p, i) => insetX(i) + "," + insetY(p.close)).join(" ");
const latest = dailyPrices[dailyPrices.length - 1];
const latestCloseLabel = latest ? "$" + latest.close.toFixed(2) : "—";
const latestDateLabel = latest ? latest.date : "No daily data loaded";
const latestQuarter = quarterlyPrices.at(-1)?.label;
const quarterPrices = quarterlyPrices.filter((q) => {
  const startMonth = q.quarter === 1 ? "02" : q.quarter === 2 ? "05" : q.quarter === 3 ? "08" : "11";
  const expectedStart = `${q.firstDate.slice(0, 4)}-${startMonth}-01`;
  const startedNearQuarterBoundary = q.firstDate.slice(0, 7) === expectedStart.slice(0, 7) && Number(q.firstDate.slice(8, 10)) <= 7;
  return q.label === latestQuarter || startedNearQuarterBoundary;
}).map((q) => ({ ...q, value: q.volumeWeightedClose, partial: q.label === latestQuarter }));
const [quarterPriceMin, quarterPriceMax] = getRange(quarterPrices.map((q) => q.value), 50, 100);
const quarterStep = (annualPlot.right - annualPlot.left) / Math.max(1, quarterPrices.length - 1);
const quarterLine = quarterPrices.map((q, i) => (annualPlot.left + i * quarterStep) + "," + annualY(q.value, quarterPriceMin, quarterPriceMax)).join(" ");
const rollingWindows = [5, 10, 21, 63] as const;
const rollingRows = dailyPrices.map((p, i) => {
  const traces = Object.fromEntries(rollingWindows.map((window) => {
    const start = Math.max(0, i - window + 1);
    const slice = dailyPrices.slice(start, i + 1);
    const volume = slice.reduce((sum, row) => sum + row.volume, 0);
    const weightedClose = slice.reduce((sum, row) => sum + row.close * row.volume, 0);
    return [window, volume > 0 ? weightedClose / volume : p.close];
  })) as Record<5 | 10 | 21 | 63, number>;
  return { ...p, ...traces };
});
const rollingRecent = rollingRows.slice(-90);
const rollingValues = rollingRecent.flatMap((p) => rollingWindows.map((window) => p[window]));
const [rollingMin, rollingMax] = getRange(rollingValues, 50, 100);
const rollingPlot = { left: 54, top: 34, bottom: 218, right: 718 };
const rollingX = (i: number) => rollingRecent.length <= 1 ? 386 :
  rollingPlot.left + i * ((rollingPlot.right - rollingPlot.left) / (rollingRecent.length - 1));
const rollingY = (value: number) =>
  rollingPlot.bottom - ((value - rollingMin) / (rollingMax - rollingMin || 1)) * (rollingPlot.bottom - rollingPlot.top);
const rollingLine = (window: 5 | 10 | 21 | 63) =>
  rollingRecent.map((p, i) => rollingX(i) + "," + rollingY(p[window])).join(" ");
const rollingMonthTicks = rollingRecent.map((p, i) => ({ p, i })).filter(({ p, i }) =>
  i === 0 || p.date.slice(0, 7) !== (rollingRecent[i - 1]?.date ?? "").slice(0, 7)
);
const filingImpliedPrice = 6_500_000 / 65_670;

---
<section class="company-charts" aria-labelledby="company-charts-title">
  <div class="section-intro">
    <p class="eyebrow">Personal reference · supplemental charts</p>
    <h2 id="company-charts-title">The business—and the stock</h2>
    <p class="lede">Two different lenses: transaction volume shows activity across the platform; the stock-price estimate is only market context, not an operating metric.</p>
  </div>

  <article class="chart-card" aria-labelledby="gtv-title">
    <div class="chart-heading">
      <div>
        <h3 id="gtv-title">Quarterly gross transaction volume</h3>
        <p class="chart-subtitle">Reported GTV · USD billions · fiscal quarters</p>
      </div>
      <div class="metric">
        <strong>$26.8B</strong>
        <span>Q2 FY2027</span>
      </div>
    </div>
    <figure>
      <svg class="chart" viewBox="0 0 760 236" role="img" aria-labelledby="gtv-svg-title gtv-svg-desc">
        <title id="gtv-svg-title">ServiceTitan quarterly gross transaction volume</title>
        <desc id="gtv-svg-desc">GTV was 17.7 billion dollars in Q1 FY2026, 22.9 in Q2, 21.7 in Q3, 19.8 in Q4, 21.7 in Q1 FY2027, and 26.8 in Q2 FY2027.</desc>
        {[0, 10, 20, 30].map((tick) => (
          <g>
            <line x1={chart.left} x2={chart.width} y1={chart.bottom - (tick / chart.max) * (chart.bottom - chart.top)} y2={chart.bottom - (tick / chart.max) * (chart.bottom - chart.top)} class="gridline" />
            <text x={chart.left - 12} y={chart.bottom - (tick / chart.max) * (chart.bottom - chart.top) + 4} text-anchor="end" class="axis-label">{tick}</text>
          </g>
        ))}
        <text x="14" y="15" class="axis-title">USD B</text>
        {quarters.map((q, i) => (
          <g>
            <rect x={barX(i)} y={chart.bottom - barHeight(q.value)} width={barWidth} height={barHeight(q.value)} rx="4" class={i === quarters.length - 1 ? "bar bar-highlight" : "bar"} />
            <text x={barX(i) + barWidth / 2} y={chart.bottom - barHeight(q.value) - 9} text-anchor="middle" class="value-label">{q.value.toFixed(1)}</text>
            <text x={barX(i) + barWidth / 2} y={chart.bottom + 22} text-anchor="middle" class="quarter-label">{q.label}</text>
          </g>
        ))}
        <line x1={chart.left} x2={chart.width} y1={chart.bottom} y2={chart.bottom} class="baseline" />
      </svg>
      <figcaption>GTV is the total dollar value invoiced by customers through the platform—not ServiceTitan’s own revenue. Q2 FY2027 GTV increased 17% year over year.</figcaption>
    </figure>
    <p class="source-line">Sources: <a href="https://investors.servicetitan.com/news-releases/news-release-details/servicetitan-announces-fiscal-first-quarter-financial-results-0">Q1 FY2027</a> · <a href="https://investors.servicetitan.com/news-releases/news-release-details/servicetitan-announces-fiscal-second-quarter-financial-results-0">Q2 FY2027</a> · <a href="https://investors.servicetitan.com/news-releases/news-release-details/servicetitan-announces-fiscal-third-quarter-financial-results">Q3 FY2026</a> · <a href="https://servicetitan.gcs-web.com/news-releases/news-release-details/servicetitan-announces-fiscal-fourth-quarter-and-full-fiscal">Q4 FY2026 and full year</a> · <a href="https://investors.servicetitan.com/news-releases/news-release-details/servicetitan-announces-fiscal-second-quarter-financial-results">Q2 FY2026</a>.</p>
  </article>

  <article id="ttan-vwap-year" class="chart-card stock-card" aria-labelledby="vwap-title">
    <div class="chart-heading">
      <div>
        <h3 id="vwap-title">TTAN quarterly volume-weighted closing price</h3>
        <p class="chart-subtitle">Daily closes weighted by daily volume · USD per share</p>
      </div>
      <div class="metric metric-muted">
        <strong>{quarterPrices.length ? "$" + quarterPrices[quarterPrices.length - 1]!.value.toFixed(2) : "—"}</strong>
        <span>{quarterPrices[quarterPrices.length - 1]?.label ?? "No data"} quarter-to-date · {latestDateLabel}</span>
      </div>
    </div>
    <figure>
      <svg class="chart" viewBox="0 0 760 270" role="img" aria-labelledby="vwap-svg-title vwap-svg-desc">
        <title id="vwap-svg-title">TTAN quarterly volume-weighted average closing price</title>
        <desc id="vwap-svg-desc">Quarterly volume-weighted average closing prices for ServiceTitan stock, using daily closing prices weighted by daily volume. The latest fiscal quarter is quarter-to-date.</desc>
        {[quarterPriceMin, (quarterPriceMin + quarterPriceMax) / 2, quarterPriceMax].map((tick) => (
          <g>
            <line x1={annualPlot.left} x2={annualPlot.right} y1={annualY(tick, quarterPriceMin, quarterPriceMax)} y2={annualY(tick, quarterPriceMin, quarterPriceMax)} class="gridline" />
            <text x={annualPlot.left - 10} y={annualY(tick, quarterPriceMin, quarterPriceMax) + 4} text-anchor="end" class="axis-label">{"$" + tick.toFixed(0)}</text>
          </g>
        ))}
        <line x1={annualPlot.left} x2={annualPlot.right} y1={annualY(filingImpliedPrice, quarterPriceMin, quarterPriceMax)} y2={annualY(filingImpliedPrice, quarterPriceMin, quarterPriceMax)} class="filing-reference" />
        <text x={annualPlot.right - 4} y={annualY(filingImpliedPrice, quarterPriceMin, quarterPriceMax) - 5} text-anchor="end" class="filing-reference-label">FY26 filing-implied $98.98</text>
        {quarterPrices.length > 1 && <polyline points={quarterLine} class="vwap-line" />}
        {quarterPrices.map((q, i) => (
          <g>
            <circle cx={annualPlot.left + i * quarterStep} cy={annualY(q.value, quarterPriceMin, quarterPriceMax)} r="5" class={q.partial ? "quarter-point quarter-point-current" : "quarter-point"} />
            <text x={annualPlot.left + i * quarterStep} y={annualY(q.value, quarterPriceMin, quarterPriceMax) - 10} text-anchor="middle" class="value-label">{"$" + q.value.toFixed(2)}</text>
            <text x={annualPlot.left + i * quarterStep} y={annualPlot.bottom + 19} text-anchor="middle" class="quarter-label">{q.label}{q.partial ? " · QTD" : ""}</text>
          </g>
        ))}
        {quarterPrices.length === 0 && <text x="380" y="125" text-anchor="middle" class="empty-state">No quarterly price data available</text>}
        <line x1={annualPlot.left} x2={annualPlot.right} y1={annualPlot.bottom} y2={annualPlot.bottom} class="baseline" />
      </svg>
      <div class="chart-legend"><span><i class="legend-vwap"></i> Quarterly volume-weighted closing price</span><span><i class="legend-price"></i> Dashed line: filing-implied FY26 price</span></div>
      <figcaption>The FY26 Q1 daily-close × daily-volume result is $99.27, about 0.29% above the $98.98 price implied by the filing’s rounded $6.5M target and 65,670 RSUs. The filing does not disclose an exact conversion price. Later quarters use the same calculation for comparison; Q3 FY27 is quarter-to-date. The filing describes FY26 executive grants and does not establish the method for every employee grant.</figcaption>
    </figure>
    <p class="source-line">Data: <a href="https://finance.yahoo.com/quote/TTAN/history/">Yahoo Finance historical daily prices and volume</a>. Method: <a href="https://www.sec.gov/Archives/edgar/data/1638826/000163882626000038/ttan-20260505.htm">ServiceTitan FY2026 proxy statement</a>. <a class="chart-link" href="https://sp7412.github.io/onboarding/whitepaper/01-company/#ttan-vwap-year">Permanent link to the quarterly price plot ↗</a></p>
  </article>

  <article id="ttan-vwap-rolling" class="chart-card stock-card" aria-labelledby="rolling-vwap-title">
    <div class="chart-heading">
      <div>
        <h3 id="rolling-vwap-title">TTAN rolling VWAP proxy · daily resolution</h3>
        <p class="chart-subtitle">Last 90 sessions · volume-weighted daily closes · USD per share</p>
      </div>
      <div class="metric metric-muted">
        <strong>{rollingRecent.length ? "$" + rollingRecent[rollingRecent.length - 1]![63].toFixed(2) : "—"}</strong>
        <span>63-session reference · {latestDateLabel}</span>
      </div>
    </div>
    <figure>
      <svg class="chart" viewBox="0 0 760 270" role="img" aria-labelledby="rolling-vwap-svg-title rolling-vwap-svg-desc">
        <title id="rolling-vwap-svg-title">TTAN rolling volume-weighted closing-price proxies</title>
        <desc id="rolling-vwap-svg-desc">Daily rolling volume-weighted averages of closing prices over 5, 10, 21, and 63 trading sessions for the latest 90 sessions. Shorter windows respond more quickly to price changes and show more noise. These are not trade-level VWAPs.</desc>
        {[rollingMin, (rollingMin + rollingMax) / 2, rollingMax].map((tick) => (
          <g>
            <line x1={rollingPlot.left} x2={rollingPlot.right} y1={rollingY(tick)} y2={rollingY(tick)} class="gridline" />
            <text x={rollingPlot.left - 10} y={rollingY(tick) + 4} text-anchor="end" class="axis-label">{"$" + tick.toFixed(0)}</text>
          </g>
        ))}
        {rollingRecent.length > 1 && <polyline points={rollingLine(5)} class="rolling-line rolling-5" />}
        {rollingRecent.length > 1 && <polyline points={rollingLine(10)} class="rolling-line rolling-10" />}
        {rollingRecent.length > 1 && <polyline points={rollingLine(21)} class="rolling-line rolling-21" />}
        {rollingRecent.length > 1 && <polyline points={rollingLine(63)} class="rolling-line rolling-63" />}
        {rollingMonthTicks.map((tick) => <text x={rollingX(tick.i)} y={rollingPlot.bottom + 19} text-anchor="middle" class="quarter-label">{(monthNames[Number(tick.p.date.slice(5, 7)) - 1] ?? "???") + " '" + tick.p.date.slice(2, 4)}</text>)}
        <line x1={rollingPlot.left} x2={rollingPlot.right} y1={rollingPlot.bottom} y2={rollingPlot.bottom} class="baseline" />
      </svg>
      <div class="chart-legend rolling-legend">
        <span><i class="legend-rolling-5"></i> 5-session · most responsive/noisy</span>
        <span><i class="legend-rolling-10"></i> 10-session</span>
        <span><i class="legend-rolling-21"></i> 21-session · about one month</span>
        <span><i class="legend-rolling-63"></i> 63-session · about one quarter</span>
      </div>
      <figcaption>Each point is recomputed from a trailing window ending on that session: sum(close × volume) ÷ sum(volume). Short windows expose more day-to-day movement; longer windows damp it. Because the source is daily OHLCV, this is a close-based VWAP proxy—not consolidated intraday trade-level VWAP.</figcaption>
    </figure>
    <p class="source-line">Data: <a href="https://finance.yahoo.com/quote/TTAN/history/">Yahoo Finance historical daily prices and volume</a>. <a class="chart-link" href="https://sp7412.github.io/onboarding/whitepaper/01-company/#ttan-vwap-rolling">Permanent link to rolling price traces ↗</a></p>
  </article>

  <article id="ttan-stock-price-year" class="chart-card stock-card" aria-labelledby="stock-price-title">
    <div class="chart-heading">
      <div>
        <h3 id="stock-price-title">TTAN raw daily closing price · one year</h3>
        <p class="chart-subtitle">Every trading session, unsmoothed · USD per share</p>
      </div>
      <div class="metric">
        <strong>{latestCloseLabel}</strong>
        <span>Latest close · {latestDateLabel}</span>
      </div>
    </div>
    <figure>
      <svg class="chart" viewBox="0 0 760 390" role="img" aria-labelledby="price-svg-title price-svg-desc">
        <title id="price-svg-title">TTAN daily closing price over one year</title>
        <desc id="price-svg-desc">Unsmoothed daily closing prices for every available trading session over one year, with the latest ten sessions shown in the inset.</desc>
        {[priceMin, (priceMin + priceMax) / 2, priceMax].map((tick) => (
          <g>
            <line x1={annualPlot.left} x2={annualPlot.right} y1={annualY(tick, priceMin, priceMax)} y2={annualY(tick, priceMin, priceMax)} class="gridline" />
            <text x={annualPlot.left - 10} y={annualY(tick, priceMin, priceMax) + 4} text-anchor="end" class="axis-label">{"$" + tick.toFixed(0)}</text>
          </g>
        ))}
        {dailyPrices.length > 1 && <polyline points={priceLine} class="price-line annual-price-line" />}
        {monthTicks.map((tick) => <text x={annualX(tick.index, dailyPrices.length)} y={annualPlot.bottom + 19} text-anchor="middle" class="quarter-label">{tick.label}</text>)}
        <rect x={inset.left - 7} y={inset.top - 20} width={inset.right - inset.left + 14} height={inset.bottom - inset.top + 34} rx="7" class="inset-frame" />
        <text x={inset.left} y={inset.top - 7} class="inset-title">LAST 2 WEEKS · DAILY CLOSE</text>
        {[insetMin, (insetMin + insetMax) / 2, insetMax].map((tick) => (
          <g>
            <line x1={inset.left} x2={inset.right} y1={insetY(tick)} y2={insetY(tick)} class="gridline" />
            <text x={inset.left - 5} y={insetY(tick) + 3} text-anchor="end" class="inset-axis">{"$" + tick.toFixed(0)}</text>
          </g>
        ))}
        {recentPrices.length > 1 && <polyline points={recentPriceLine} class="price-line" />}
        {recentPrices.map((p, i) => <circle cx={insetX(i)} cy={insetY(p.close)} r={i === recentPrices.length - 1 ? 3.5 : 2.2} class={i === recentPrices.length - 1 ? "price-point price-point-current" : "price-point"} />)}
        <text x={inset.left + 4} y={inset.bottom + 13} class="inset-axis">{recentPrices[0]?.date ?? "—"}</text>
        <text x={inset.right - 4} y={inset.bottom + 13} text-anchor="end" class="inset-axis">{latestDateLabel}</text>
        <line x1={annualPlot.left} x2={annualPlot.right} y1={annualPlot.bottom} y2={annualPlot.bottom} class="baseline" />
      </svg>
      <figcaption>This plot shows every available daily close across the year without smoothing. The inset zooms in on the latest ten trading sessions.</figcaption>
    </figure>
    <p class="source-line">Data: <a href="https://finance.yahoo.com/quote/TTAN/history/">Yahoo Finance historical daily prices</a>. <a class="chart-link" href="https://sp7412.github.io/onboarding/whitepaper/01-company/#ttan-stock-price-year">Permanent link to daily closing prices ↗</a></p>
  </article>
</section>

<style>
  .company-charts { margin: 3rem 0 1.5rem; max-width: 72ch; color: var(--ink); }
  .section-intro { margin-bottom: 1rem; }
  .eyebrow { margin: 0 0 .4rem; color: var(--cyan); font-size: .74rem; font-weight: 600; letter-spacing: .11em; text-transform: uppercase; }
  .section-intro h2 { margin: 0 0 .5rem; padding: 0; border: 0; font-size: 1.4rem; }
  .lede { margin: 0; color: var(--ink-dim); font-size: .94rem; line-height: 1.55; }
  .chart-card { margin: 1rem 0; padding: 1rem 1rem .85rem; border: 1px solid var(--panel-edge); border-radius: var(--r2); background: linear-gradient(145deg, #20242b, #171c25 72%); }
  .chart-heading { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; margin-bottom: .6rem; }
  .chart-heading h3 { margin: 0 0 .25rem; font-size: 1.02rem; }
  .chart-subtitle { margin: 0; color: var(--ink-dim); font-size: .8rem; }
  .metric { flex: none; text-align: right; }
  .metric strong { display: block; color: var(--cyan); font: 700 1.35rem/1.15 var(--font-head); letter-spacing: -.03em; }
  .metric span { color: var(--ink-dim); font-size: .7rem; }
  .metric-muted strong { color: #a9c8ff; }
  figure { margin: .5rem 0 0; }
  .chart { display: block; width: 100%; height: auto; overflow: visible; }
  .gridline { stroke: #454b55; stroke-width: 1; stroke-dasharray: 3 5; }
  .baseline { stroke: #6c7480; stroke-width: 1; }
  .axis-label { fill: #aeb6c2; font: 11px var(--font-body); }
  .axis-title { fill: #aeb6c2; font: 11px var(--font-body); }
  .bar { fill: #367fc5; opacity: .88; }
  .bar-highlight { fill: #6dbaf8; opacity: 1; }
  .value-label { fill: #f4f7fb; font: 600 11px var(--font-body); }
  .quarter-label { fill: #aeb6c2; font: 10px var(--font-body); }
  .vwap-line { fill: none; stroke: #8eb4ff; stroke-width: 2.6; stroke-linecap: round; stroke-linejoin: round; }
  .point { fill: #171c25; stroke: #8eb4ff; stroke-width: 2; }
  .point-current { fill: #8eb4ff; stroke: #fff; stroke-width: 1.5; }
  figcaption { margin-top: .4rem; color: var(--ink-dim); font-size: .78rem; line-height: 1.5; }
  .source-line { margin: .7rem 0 0; color: var(--ink-dim); font-size: .76rem; line-height: 1.55; }
  .source-line a { white-space: normal; }
  @media (max-width: 560px) {
    .chart-card { padding: .8rem .65rem; }
    .chart-heading { gap: .5rem; }
    .chart-heading h3 { font-size: .94rem; }
    .metric strong { font-size: 1.12rem; }
    .metric span { font-size: .65rem; }
    .quarter-label { font-size: 9px; }
    .value-label { font-size: 10px; }
  }

  .inset-frame { fill: #111720; stroke: #687382; stroke-width: 1; }
  .inset-title { fill: #f4f7fb; font: 600 9px var(--font-body); letter-spacing: .04em; }
  .inset-axis { fill: #aeb6c2; font: 8px var(--font-body); }
  .price-line { fill: none; stroke: #f3b45b; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .annual-price-line { stroke-width: 2.5; }
  .price-point { fill: #171c25; stroke: #f3b45b; stroke-width: 1.5; }
  .quarter-point { fill: #171c25; stroke: #8eb4ff; stroke-width: 2.5; }
  .quarter-point-current { fill: #8eb4ff; stroke: #fff; stroke-width: 1.5; }
  .filing-reference { stroke: #f3b45b; stroke-width: 1.2; stroke-dasharray: 5 4; }
  .filing-reference-label { fill: #f3b45b; font: 600 9px var(--font-body); }
  .price-point-current { fill: #f3b45b; stroke: #fff; stroke-width: 1; }
