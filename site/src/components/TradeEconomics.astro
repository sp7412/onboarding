---
const trades = [
  { name: "HVAC + plumbing", naics: "238220", receipts: 297.6, establishments: 109601, color: "#64b5f6" },
  { name: "Electrical", naics: "238210", receipts: 249.2, establishments: 81842, color: "#37e0ff" },
  { name: "Landscaping", naics: "561730", receipts: 115.4, establishments: 117109, color: "#62d6a5" },
  { name: "Roofing", naics: "238160", receipts: 69.9, establishments: 24532, color: "#b39cff" },
  { name: "Painting", naics: "238320", receipts: 33.0, establishments: 37963, color: "#ffbf69" },
  { name: "Pest control", naics: "561710", receipts: 19.9, establishments: 16080, color: "#f28ca8" },
];
const total = trades.reduce((sum, trade) => sum + trade.receipts, 0);
const fmt = (value: number) => value.toLocaleString("en-US", { maximumFractionDigits: 1 });
const pct = (value: number) => (value / total * 100).toFixed(1);
const cx = 150;
const cy = 145;
const radius = 112;
let currentAngle = -90;
const slices = trades.map((trade) => {
  const startAngle = currentAngle;
  const endAngle = startAngle + trade.receipts / total * 360;
  currentAngle = endAngle;
  const toPoint = (angle: number) => {
    const radians = angle * Math.PI / 180;
    return [cx + radius * Math.cos(radians), cy + radius * Math.sin(radians)];
  };
  const [x1, y1] = toPoint(startAngle);
  const [x2, y2] = toPoint(endAngle);
  const largeArc = endAngle - startAngle > 180 ? 1 : 0;
  return {
    ...trade,
    share: pct(trade.receipts),
    path: `M ${cx} ${cy} L ${x1} ${y1} A ${radius} ${radius} 0 ${largeArc} 1 ${x2} ${y2} Z`,
  };
});
const largest = trades[0];
---

<section class="trade-economics" aria-labelledby="trade-economics-title">
  <div class="section-intro">
    <p class="eyebrow">Industry economics · U.S. Census baseline</p>
    <h2 id="trade-economics-title">Which trades generate the most revenue?</h2>
    <p class="lede">Six core trade categories recorded about ${"$"}{fmt(total)}B in 2022 establishment receipts. HVAC and plumbing is the largest combined category; the Census does not split the two trades in this NAICS code.</p>
  </div>

  <article class="chart-card" aria-labelledby="trade-receipts-title">
    <div class="chart-heading">
      <div>
        <h3 id="trade-receipts-title">Receipts by selected trade</h3>
        <p class="chart-subtitle">2022 · U.S. dollars · billions</p>
      </div>
      <div class="metric">
        <strong>${"$"}{fmt(largest.receipts)}B</strong>
        <span>HVAC + plumbing</span>
      </div>
    </div>
    <div class="chart-layout">
      <figure class="pie-figure">
        <svg class="pie-chart" viewBox="0 0 300 290" role="img" aria-labelledby="trade-pie-title trade-pie-desc">
          <title id="trade-pie-title">Revenue shares among six selected U.S. trade categories</title>
          <desc id="trade-pie-desc">The selected categories total ${"$"}{fmt(total)} billion in 2022 receipts. HVAC and plumbing account for ${"$"}{fmt(trades[0].receipts)} billion, electrical ${"$"}{fmt(trades[1].receipts)} billion, landscaping ${"$"}{fmt(trades[2].receipts)} billion, roofing ${"$"}{fmt(trades[3].receipts)} billion, painting ${"$"}{fmt(trades[4].receipts)} billion, and pest control ${"$"}{fmt(trades[5].receipts)} billion.</desc>
          {slices.map((slice) => <path d={slice.path} fill={slice.color} stroke="#171c25" stroke-width="2"><title>{slice.name}: ${"$"}{fmt(slice.receipts)}B ({slice.share}%)</title></path>)}
          <circle cx={cx} cy={cy} r="57" fill="#171c25" />
          <text x={cx} y={cy - 4} text-anchor="middle" class="pie-total">${"$"}{fmt(total)}B</text>
          <text x={cx} y={cy + 16} text-anchor="middle" class="pie-caption">selected trades</text>
        </svg>
      </figure>
      <ul class="legend" aria-label="Trade revenue legend">
        {slices.map((slice) => (
          <li>
            <span class="swatch" style={`--swatch: ${slice.color}`} aria-hidden="true"></span>
            <span class="legend-name">{slice.name}<small>NAICS {slice.naics} · {slice.share}%</small></span>
            <strong>${"$"}{fmt(slice.receipts)}B</strong>
          </li>
        ))}
      </ul>
    </div>
    <p class="footnote">This pie shows each category's share of these six selected categories—not its share of every trade or all home services. Receipts include residential, commercial, and industrial work where present; they are not contractor profit or ServiceTitan revenue.</p>
    <p class="source-line">Source: <a href="https://ctacquisitions.com/guides/home-services-market-size-statistics-2026/">Census 2022 Economic Census receipts compiled by CT Acquisitions</a>; methodology and NAICS definitions are documented in the source. <a href="https://www.census.gov/programs-surveys/economic-census.html">U.S. Census Bureau Economic Census</a>.</p>
  </article>

  <article class="chart-card model-card" aria-labelledby="business-model-title">
    <div class="chart-heading">
      <div>
        <h3 id="business-model-title">How the trades make their money</h3>
        <p class="chart-subtitle">Business-model tendencies, not a measured revenue split</p>
      </div>
    </div>
    <div class="model-table-wrap">
      <table class="model-table">
        <thead><tr><th scope="col">Trade</th><th scope="col">Typical revenue pattern</th><th scope="col">Recurring component</th></tr></thead>
        <tbody>
          <tr><th scope="row">HVAC + plumbing</th><td>Repair, replacement, installation, emergency calls</td><td>Maintenance agreements are common in HVAC; plumbing is often repair- and project-led</td></tr>
          <tr><th scope="row">Electrical</th><td>Projects, upgrades, repairs, new installations</td><td>Usually less contract-driven in residential work; commercial maintenance can be meaningful</td></tr>
          <tr><th scope="row">Landscaping</th><td>Recurring lawn/grounds visits plus design and hardscape projects</td><td>Seasonal route contracts can be central to lawn-care operators</td></tr>
          <tr><th scope="row">Roofing</th><td>Replacement and storm/insurance projects</td><td>Generally low; roof replacement cycles are measured in decades</td></tr>
          <tr><th scope="row">Painting</th><td>Discrete residential or commercial projects</td><td>Usually low for residential repainting; commercial contracts vary</td></tr>
          <tr><th scope="row">Pest control</th><td>Treatments and prevention plans</td><td>High; one industry compilation estimates about 85% recurring residential revenue</td></tr>
        </tbody>
      </table>
    </div>
    <p class="footnote">There is no consistent public dataset that splits every trade's receipts into installation, repair, and maintenance on the same basis. Treat these as operating-model descriptions, not percentages. The recurring-revenue estimate for pest control is a secondary-source estimate, not a Census measure.</p>
    <p class="source-line">Recurring-model reference: <a href="https://my.ceo-copilot.net/investor/us-residential-home-services.php">U.S. Residential Home Services industry baseline report</a>.</p>
  </article>
</section>

<style>
  .trade-economics { margin: 3rem 0 1.5rem; max-width: 72ch; color: var(--ink); }
  .section-intro { margin-bottom: 1rem; }
  .eyebrow { margin: 0 0 .4rem; color: var(--cyan); font-size: .74rem; font-weight: 600; letter-spacing: .11em; text-transform: uppercase; }
  .section-intro h2 { margin: 0 0 .5rem; padding: 0; border: 0; font-size: 1.4rem; }
  .lede { margin: 0; color: var(--ink-dim); font-size: .94rem; line-height: 1.55; }
  .chart-card { margin: 1rem 0; padding: 1rem 1rem .85rem; border: 1px solid var(--panel-edge); border-radius: var(--r2); background: linear-gradient(145deg, #20242b, #171c25 72%); }
  .chart-heading { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; margin-bottom: .6rem; }
  .chart-heading h3 { margin: 0 0 .25rem; font-size: 1.02rem; }
  .chart-subtitle { margin: 0; color: var(--ink-dim); font-size: .8rem; }
  .metric { flex: none; text-align: right; }
  .metric strong { display: block; color: var(--cyan); font: 700 1.35rem/1.15 var(--font-head); letter-spacing: -.03em; }
  .metric span { color: var(--ink-dim); font-size: .7rem; }
  .chart-layout { display: grid; grid-template-columns: minmax(220px, .85fr) minmax(250px, 1fr); gap: .75rem; align-items: center; }
  .pie-figure { margin: 0; min-width: 0; }
  .pie-chart { display: block; width: 100%; height: auto; overflow: visible; }
  .pie-total { fill: #f4f7fb; font: 700 20px var(--font-head); }
  .pie-caption { fill: #aeb6c2; font: 10px var(--font-body); }
  .legend { list-style: none; margin: 0; padding: 0; display: grid; gap: .25rem; }
  .legend li { display: grid; grid-template-columns: 10px minmax(0, 1fr) auto; gap: .5rem; align-items: center; padding: .45rem 0; border-bottom: 1px solid #343b46; }
  .swatch { width: 9px; height: 9px; border-radius: 2px; background: var(--swatch); }
  .legend-name { color: #f4f7fb; font-size: .83rem; }
  .legend-name small { display: block; margin-top: .12rem; color: #aeb6c2; font-size: .7rem; }
  .legend strong { color: #f4f7fb; font-size: .82rem; white-space: nowrap; }
  .footnote { margin: .7rem 0 0; color: var(--ink-dim); font-size: .78rem; line-height: 1.5; }
  .source-line { margin: .6rem 0 0; color: var(--ink-dim); font-size: .76rem; line-height: 1.55; }
  .source-line a { overflow-wrap: anywhere; }
  .model-table-wrap { overflow-x: auto; }
  .model-table { width: 100%; border-collapse: collapse; min-width: 34rem; font-size: .82rem; line-height: 1.5; }
  .model-table th, .model-table td { padding: .55rem .6rem; border-bottom: 1px solid #343b46; text-align: left; vertical-align: top; }
  .model-table thead th { color: var(--cyan); font-weight: 600; }
  .model-table tbody th { color: #f4f7fb; font-weight: 600; white-space: nowrap; }
  .model-table td { color: #c1c8d2; }
  @media (max-width: 560px) {
    .chart-card { padding: .8rem .65rem; }
    .chart-layout { grid-template-columns: 1fr; }
    .pie-chart { max-width: 310px; margin: 0 auto; }
    .legend li { padding: .35rem 0; }
    .chart-heading h3 { font-size: .94rem; }
    .metric strong { font-size: 1.12rem; }
  }
</style>
