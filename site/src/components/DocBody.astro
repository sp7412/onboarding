---
import { repoLinkToRoute } from "../lib/content/repo";
import { renderMarkdown } from "../lib/markdown";
import { url } from "../lib/url";

interface Props {
  body: string;
  sourcePath: string;
  idPrefix?: string;
  skipH1?: boolean;
}

const { body, sourcePath, idPrefix, skipH1 = true } = Astro.props;

const { html } = renderMarkdown(body, {
  sourcePath,
  idPrefix,
  skipH1,
  resolveRepoLink: (repoPath) => {
    const route = repoLinkToRoute(repoPath);
    return route ? url(route) : null;
  },
});
---

<div class="doc-body" set:html={html} />

<style is:global>
  .doc-body { max-width: 76ch; }
  .doc-body h2 { margin-top: var(--s8); font-size: 1.45rem; }
  .doc-body h3 { margin-top: var(--s6); font-size: 1.15rem; }
  .doc-body blockquote {
    margin: var(--s4) 0;
    padding: var(--s2) var(--s4);
    border-left: 3px solid var(--cyan);
    background: var(--panel);
    border-radius: 0 var(--r1) var(--r1) 0;
  }
  .doc-body .table-wrap { overflow-x: auto; margin: var(--s4) 0; }
  .doc-body table { border-collapse: collapse; width: 100%; font-size: 0.95rem; }
  .doc-body th, .doc-body td { border-bottom: 1px solid var(--panel-edge); padding: var(--s2) var(--s3); text-align: left; vertical-align: top; }
  .doc-body th { color: var(--cyan); font-family: var(--font-head); font-weight: 500; }
  .doc-body pre { background: var(--panel); border: 1px solid var(--panel-edge); border-radius: var(--r1); padding: var(--s4); overflow-x: auto; white-space: pre-wrap; }
  .doc-body figure.mermaid-src figcaption { font-size: 0.9rem; color: var(--ink-dim); margin-bottom: var(--s2); }
  .doc-body figure.mermaid-src { margin: var(--s4) 0; }
  .doc-body ul.task-list { list-style: none; padding-left: var(--s2); }
  .doc-body label.task { display: inline-flex; gap: var(--s2); align-items: flex-start; }
  .doc-body label.task input { margin-top: 0.35em; accent-color: var(--green); }
  .doc-body hr { border: 0; border-top: 1px solid var(--panel-edge); margin: var(--s8) 0; }
  .doc-body .table-row {
    border-bottom: 1px solid var(--panel-edge);
    padding: var(--s1) 0;
    margin: 0;
    font-size: 0.95rem;
  }
</style>
