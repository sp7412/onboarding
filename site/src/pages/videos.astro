---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { readRepoFile } from "../lib/content/repo";
import { parseVideos, VIDEO_TOPICS, WATCH_WHEN, topicOf } from "../lib/content/videos";
import { url } from "../lib/url";

const videos = parseVideos(readRepoFile("docs/reading-guide.md"), "docs/reading-guide.md");
const must = videos.filter((v) => v.mustWatch);
const mustMinutes = must.reduce((sum, v) => sum + (v.minutes ?? 0), 0);
const untimed = must.filter((v) => v.minutes === null);
const fmt = (m: number) => (m >= 60 ? `${Math.floor(m / 60)} h ${m % 60} min` : `${m} min`);
const groups = VIDEO_TOPICS.map((t) => ({ ...t, videos: videos.filter((v) => topicOf(v.itemNumber) === t.key) })).filter((g) => g.videos.length);
---
<BaseLayout title="Videos · Path to Integration" description="Every video in the onboarding guide, grouped by topic and ordered by priority.">
  <p class="crumb muted"><a href={url("/")}>Journey</a> / videos</p>
  <div class="page-title"><Icon name="play" badge size={22} tone="cyan" /><h1>Videos</h1></div>
  <p class="page-lede">
    {videos.length} videos and courses from the <a href={url("/reading")}>reading guide</a>.
    The must-watch set is about <strong>{fmt(mustMinutes)}</strong>{untimed.length > 0 && <> plus the LiveKit 101 course, which you can sample</>}.
    Checking a video here also checks it in the reading guide. Links open YouTube in a new tab; nothing loads from YouTube until you click.
  </p>
  <nav class="toc" aria-label="Topics">{groups.map((g) => <a href={`#${g.key}`}>{g.title}</a>)}</nav>

  {groups.map((g) => (
    <section class="topic" id={g.key}>
      <h2>{g.title}</h2>
      <p class="muted">{g.blurb}</p>
      <div class="video-grid">
        {g.videos.map((v) => (
          <article class:list={["video-card", { must: v.mustWatch }]}>
            <a class="poster" href={v.url} target="_blank" rel="noopener noreferrer" aria-label={`Watch ${v.title} on YouTube (opens in a new tab)`}>
              <Icon name="play" size={34} />
              <span class="len">{v.isPlaylist ? "Playlist" : v.time}</span>
            </a>
            <div class="body">
              <div class="tags">
                {v.mustWatch ? <span class="tag tag-green">Must watch</span> : <span class="tag">When you have time</span>}
                {WATCH_WHEN[v.itemNumber] && <span class="when">{WATCH_WHEN[v.itemNumber]}</span>}
              </div>
              <h3><a href={v.url} target="_blank" rel="noopener noreferrer">{v.title}</a></h3>
              {v.title !== v.itemTitle && <p class="muted series">From: {v.itemTitle}</p>}
              {v.isPlaylist && <p class="muted series">{v.time}</p>}
              {v.pairsWith && <p class="muted pairs">Pairs with {v.pairsWith}</p>}
              <label class="watched"><input type="checkbox" data-check-id={v.id} /> Watched</label>
            </div>
          </article>
        ))}
      </div>
    </section>
  ))}
  <p class="muted footnote">Reading-guide item numbers and "what to look for" notes are on the <a href={url("/reading")}>Reading</a> page.</p>
</BaseLayout>
<style>
  .topic { margin: var(--s8) 0; }
  .topic h2 { margin-bottom: var(--s1); }
  .video-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: var(--s4); margin-top: var(--s4); }
  .video-card { border: 1px solid var(--panel-edge); border-radius: var(--r2); overflow: hidden; background: linear-gradient(180deg, #111c33, #0e1830); display: flex; flex-direction: column; }
  .video-card.must { border-color: #2a5a49; }
  .poster {
    position: relative; display: grid; place-items: center; aspect-ratio: 16 / 7; color: var(--cyan);
    background: radial-gradient(circle at 50% 50%, rgba(55,224,255,.18), transparent 60%), linear-gradient(135deg, #12244a, #0b1428);
    text-decoration: none;
  }
  .poster:hover, .poster:focus-visible { color: #fff; box-shadow: inset 0 0 0 2px var(--cyan); }
  .len { position: absolute; right: 10px; bottom: 8px; font-size: .78rem; background: rgba(0,0,0,.55); color: #fff; padding: 2px 8px; border-radius: 99px; }
  .body { padding: var(--s4); display: grid; gap: var(--s2); }
  .body h3 { margin: 0; font-size: 1.02rem; line-height: 1.35; }
  .body h3 a { color: var(--ink); text-decoration: none; }
  .body h3 a:hover { color: var(--cyan); text-decoration: underline; }
  .tags { display: flex; flex-wrap: wrap; gap: var(--s2); align-items: center; }
  .when { font-size: .82rem; color: var(--ink-dim); }
  .series, .pairs { font-size: .88rem; margin: 0; }
  .watched { display: inline-flex; gap: var(--s2); align-items: center; font-size: .92rem; }
  .watched input { width: 1.05rem; height: 1.05rem; accent-color: var(--green); }
  .footnote { margin-top: var(--s8); }
</style>
