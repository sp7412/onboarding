---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { readRepoFile } from "../lib/content/repo";
import { parseVideos, VIDEO_TOPICS, WATCH_WHEN, topicOf } from "../lib/content/videos";
import { url } from "../lib/url";
import { renderMarkdown } from "../lib/markdown";
import { parseVideoNotes, videoId } from "../lib/content/video-notes";
import { EXPLAINERS } from "../lib/content/explainers";

const videos = parseVideos(readRepoFile("docs/reading-guide.md"), "docs/reading-guide.md");
const videoNotes = parseVideoNotes(readRepoFile("docs/video-notes.md"), "docs/video-notes.md", videos);
const noteById = new Map(videoNotes.map((note) => [note.id, note]));
const noteFor = (v: { url: string }) => noteById.get(videoId(v.url) ?? "");
const numbered = (items: string[]) => items.map((item, i) => `${i + 1}. ${item}`).join("\n");
const must = videos.filter((v) => v.mustWatch);
const mustMinutes = must.reduce((sum, v) => sum + (v.minutes ?? 0), 0);
const untimed = must.filter((v) => v.minutes === null);
const fmt = (m: number) => (m >= 60 ? `${Math.floor(m / 60)} h ${m % 60} min` : `${m} min`);
const groups = VIDEO_TOPICS.map((t) => {
  const vs = videos.filter((v) => topicOf(v.itemNumber) === t.key);
  const byItem = [...new Set(vs.map((v) => v.itemNumber))].map((n) => ({ number: n, videos: vs.filter((v) => v.itemNumber === n) }));
  const singles = byItem.filter((i) => i.videos.length === 1).flatMap((i) => i.videos);
  const items = [
    ...(singles.length ? [{ number: "singles", videos: singles, single: true }] : []),
    ...byItem.filter((i) => i.videos.length > 1).map((i) => ({ ...i, single: false })),
  ];
  return { ...t, videos: vs, items };
}).filter((g) => g.videos.length);
const md = (s: string) => renderMarkdown(s, { sourcePath: "docs/reading-guide.md", resolveRepoLink: () => null }).html.replace(/^<p>|<\/p>$/g, "");
---
<BaseLayout title="Videos · Path to Integration" description="Every video in the onboarding guide, grouped by topic and ordered by priority.">
  <p class="crumb muted"><a href={url("/")}>Journey</a> / videos</p>
  <div class="page-title"><Icon name="play" badge size={22} tone="cyan" /><h1>Videos</h1></div>
  <p class="page-lede">
    {videos.length} videos and courses from the <a href={url("/reading")}>reading guide</a>.
    The must-watch set is about <strong>{fmt(mustMinutes)}</strong>{untimed.length > 0 && <> plus the LiveKit 101 course, which you can sample</>}.
    Checking a video here also checks it in the reading guide. Links open YouTube in a new tab; nothing loads from YouTube until you click.
  </p>
  <nav class="toc" aria-label="Topics">{groups.map((g) => <a href={`#${g.key}`}>{g.title}</a>)}</nav>

  <section class="start-here" id="start-here">
    <div class="section-head"><h2>Start here: Voice Agents from First Principles</h2><span class="tag tag-green">4 episodes</span></div>
    <p class="muted series-lede">A local, original explainer series: trace one call, understand turn-taking, choose an architecture, and locate the application control plane.</p>
    <div class="video-grid">
      {EXPLAINERS.map((e, index) => (
        <article class="video-card explainer-card" id={e.id}>
          <div class="explainer-video">
            <video controls preload="none" poster={e.posterUrl} aria-label={e.title}>
              <source src={e.videoUrl} type="video/mp4" />
              <track kind="captions" src={e.captionsUrl} srclang="en" label="English" default />
            </video>
          </div>
          <div class="body">
            <div class="tags"><span class="tag tag-green">Episode {index + 1}</span><span class="when">{e.length}</span></div>
            <h3>{e.title}</h3>
            <p class="muted series">{e.description}</p>
            <p class="media-links"><a href={e.audioUrl}>Audio-only MP3</a> · <a href={e.releaseUrl}>Release assets</a></p>
            <details class="watchfor"><summary>Check yourself</summary><ol>{e.questions.map((question) => <li>{question}</li>)}</ol></details>
            <label class="watched"><input type="checkbox" data-check-id={`explainer-${e.id}`} /> Watched</label>
          </div>
        </article>
      ))}
    </div>
  </section>

  {groups.map((g) => (
    <section class="topic" id={g.key}>
      <h2>{g.title}</h2>
      <p class="muted">{g.blurb}</p>
      {g.items.map((it) => (
        <div class="item-group">
          {!it.single && (
            <div class="series-head">
              <h3>{it.videos[0].itemTitle}</h3>
              {it.videos[0].lookFor.length > 0 && (
                <details class="watchfor">
                  <summary>What to watch for across these {it.videos.length} videos</summary>
                  {it.videos[0].why && <p class="why" set:html={md(it.videos[0].why)} />}
                  <ol>{it.videos[0].lookFor.map((l) => <li set:html={md(l)} />)}</ol>
                </details>
              )}
            </div>
          )}
          <div class="video-grid">
            {it.videos.map((v) => (
              <article class:list={["video-card", { must: v.mustWatch }]}>
                <a class="poster" href={v.url} target="_blank" rel="noopener noreferrer" aria-label={`Watch ${v.title} on YouTube (opens in a new tab)`}>
                  <Icon name="play" size={34} />
                  <span class="len">{v.isPlaylist ? "Playlist" : v.time}</span>
                </a>
                <div class="body">
                  <div class="tags">
                    {v.mustWatch ? <span class="tag tag-green">Must watch</span> : <span class="tag">When you have time</span>}
                    {WATCH_WHEN[v.itemNumber] && <span class="when">{WATCH_WHEN[v.itemNumber]}</span>}
                  </div>
                  <h4><a href={v.url} target="_blank" rel="noopener noreferrer">{v.title}</a></h4>
                  {v.isPlaylist && <p class="muted series">{v.time}</p>}
                  {v.pairsWith && <p class="muted pairs" set:html={`Pairs with ${md(v.pairsWith)}`} />}
                  {it.single && v.lookFor.length > 0 && (
                    <details class="watchfor">
                      <summary>What to watch for</summary>
                      {v.why && <p class="why" set:html={md(v.why)} />}
                      <ol>{v.lookFor.map((l) => <li set:html={md(l)} />)}</ol>
                    </details>
                  )}
                  {noteFor(v) && (
                    <details class="watchfor">
                      <summary>Notes and takeaways</summary>
                      <div class="doc-body notes" set:html={renderMarkdown(numbered(noteFor(v)!.takeaways), { sourcePath: "docs/video-notes.md", resolveRepoLink: () => null }).html} />
                      <p class="why" set:html={`<strong>Why it matters here:</strong> ${md(noteFor(v)!.why)}`} />
                      {noteFor(v)!.questions.length > 0 && (
                        <>
                          <p class="why"><strong>Questions to discuss</strong></p>
                          <div class="doc-body notes" set:html={renderMarkdown(numbered(noteFor(v)!.questions), { sourcePath: "docs/video-notes.md", resolveRepoLink: () => null }).html} />
                        </>
                      )}
                    </details>
                  )}
                  <label class="watched"><input type="checkbox" data-check-id={v.id} /> Watched</label>
                </div>
              </article>
            ))}
          </div>
        </div>
      ))}
    </section>
  ))}
  <p class="muted footnote">Notes come from <a href="https://github.com/sp7412/onboarding/blob/main/docs/video-notes.md">docs/video-notes.md</a>. Reading-guide item numbers and "what to look for" notes are on the <a href={url("/reading")}>Reading</a> page.</p>
</BaseLayout>
<style>
  .topic { margin: var(--s8) 0; }
  .start-here { margin: var(--s8) 0; }
  .section-head { display: flex; align-items: baseline; justify-content: space-between; gap: var(--s4); }
  .series-lede { max-width: 70ch; }
  .explainer-video { background: #080e1b; }
  .explainer-video video { display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: contain; }
  .media-links { margin: 0; font-size: .88rem; }
  .topic h2 { margin-bottom: var(--s1); }
  .video-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: var(--s4); margin-top: var(--s4); }
  .video-card { border: 1px solid var(--panel-edge); border-radius: var(--r2); overflow: hidden; background: linear-gradient(180deg, #111c33, #0e1830); display: flex; flex-direction: column; }
  .video-card.must { border-color: #2a5a49; }
  .poster {
    position: relative; display: grid; place-items: center; aspect-ratio: 16 / 7; color: var(--cyan);
    background: radial-gradient(circle at 50% 50%, rgba(55,224,255,.18), transparent 60%), linear-gradient(135deg, #12244a, #0b1428);
    text-decoration: none;
  }
  .poster:hover, .poster:focus-visible { color: #fff; box-shadow: inset 0 0 0 2px var(--cyan); }
  .len { position: absolute; right: 10px; bottom: 8px; font-size: .78rem; background: rgba(0,0,0,.55); color: #fff; padding: 2px 8px; border-radius: 99px; }
  .body { padding: var(--s4); display: grid; gap: var(--s2); }
  .body h4 { margin: 0; font-size: 1.02rem; line-height: 1.35; }
  .body h4 a { color: var(--ink); text-decoration: none; }
  .body h4 a:hover { color: var(--cyan); text-decoration: underline; }
  .item-group { margin-top: var(--s6); }
  .series-head h3 { margin: 0 0 var(--s2); font-size: 1.1rem; color: #cfe7ff; }
  .watchfor { font-size: .9rem; }
  .watchfor summary { cursor: pointer; color: var(--cyan); font-weight: 600; list-style: none; }
  .watchfor summary::-webkit-details-marker { display: none; }
  .watchfor summary::before { content: "▸ "; }
  .watchfor[open] summary::before { content: "▾ "; }
  .watchfor ol { margin: var(--s2) 0 0; padding-left: 1.2em; display: grid; gap: var(--s1); color: var(--ink); }
  .watchfor .why { margin: var(--s2) 0 0; color: var(--ink-dim); }
  .watchfor .notes { font-size: .9rem; max-width: none; }
  .watchfor .notes ol { margin: var(--s2) 0 0; }
  .series-head .watchfor { max-width: 72ch; margin-bottom: var(--s2); }
  .tags { display: flex; flex-wrap: wrap; gap: var(--s2); align-items: center; }
  .when { font-size: .82rem; color: var(--ink-dim); }
  .series, .pairs { font-size: .88rem; margin: 0; }
  .watched { display: inline-flex; gap: var(--s2); align-items: center; font-size: .92rem; }
  .watched input { width: 1.05rem; height: 1.05rem; accent-color: var(--green); }
  .footnote { margin-top: var(--s8); }
</style>
