---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";
import { url } from "../../lib/url";
import { lessons } from "../../lib/lessons/index";
---
<BaseLayout title="Lessons · Path to Integration" description="Interactive guided-discovery lessons for voice-agent engineering.">
  <p class="crumb muted"><a href={url("/")}>Journey</a> / lessons</p>
  <div class="page-title"><Icon name="flask" badge size={22} tone="cyan" /><h1>Interactive lessons</h1></div>
  <p class="page-lede">Four screens per idea: puzzle, explore, name, challenge. Move the system yourself, then name the pattern.</p>
  <div class="grid-cards">
    {lessons.map((lesson) => <a class="card lesson-card" href={url(`/lessons/${lesson.slug}`)}><span class="tag tag-green">{lesson.time}</span><h2>{lesson.title}</h2><p class="muted">{lesson.aha}</p><p class="related">Related: {lesson.related}</p><label onclick={(event) => event.stopPropagation()}><input type="checkbox" data-lesson-id={lesson.slug} /> Completed</label></a>)}
  </div>
</BaseLayout>
<script>
  const key = "path-to-integration-checklist";
  document.querySelectorAll<HTMLInputElement>("[data-lesson-id]").forEach((box) => {
    const id = `lesson-${box.dataset.lessonId}`;
    try { box.checked = Boolean(JSON.parse(localStorage.getItem(key) || "{}")[id]); } catch {}
    box.addEventListener("change", () => { let data = {}; try { data = JSON.parse(localStorage.getItem(key) || "{}"); } catch {} data[id] = box.checked; localStorage.setItem(key, JSON.stringify(data)); });
  });
</script>
<style>.lesson-card { display:grid; gap:var(--s2); color:inherit; text-decoration:none; } .lesson-card h2,.lesson-card p { margin:0; } .lesson-card label { color:var(--ink-dim); cursor:pointer; } .lesson-card input { accent-color:var(--green); }</style>
