---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Lesson from "../../lib/lessons/Lesson.astro";
import { url } from "../../lib/url";
const aha = "Reliability compounds: a task passed 90% of the time succeeds on all 8 tries only about 43% of the time (0.9^8), so repeat-trial success predicts production.";
---
<BaseLayout title="Pass-k reliability · Lessons" description={aha}>
  <p class="crumb muted"><a href={url("/lessons")}>Lessons</a> / pass-k</p>
  <Lesson slug="pass-k" title="The eight-step booking call" aha={aha} related="Lab 07 · τ-bench reading" time="8 min">
    <div slot="screen-0" class="lesson-content">
      <p class="prompt">A booking call needs eight separate decisions. Each looks almost reliable. Why do complete calls still fail?</p>
      <div class="mystery-dots" aria-label="Eight linked decisions; one hidden failure can stop the call">{Array.from({ length: 8 }, (_, i) => <span style={`--i:${i}`}>{i + 1}</span>)}</div>
      <p class="lesson-summary" aria-live="polite">Eight green-looking steps make one fragile chain.</p>
    </div>
    <div slot="screen-1" class="lesson-content">
      <p class="guiding">Guiding question: what happens when each step is independently reliable?</p>
      <div class="control-row" id="pass-k-controls"></div>
      <svg id="pass-k-chart" viewBox="0 0 720 280" role="img" aria-label="Probability of completing every step"></svg>
      <p id="pass-k-explore" class="lesson-summary" aria-live="polite">Move the slider to see the chain shrink.</p>
    </div>
    <div slot="screen-2" class="lesson-content">
      <p class="guiding">The formal rule is simple: if each step has probability p, then k successful steps have probability <strong>p<sup>k</sup></strong>.</p>
      <div class="formula"><span>p</span><sup>k</sup> = <span>0.90</span><sup>8</sup> = <strong>0.4305</strong></div>
      <p class="lesson-summary">You moved p, the chance each decision is right, and k, the number of decisions. The exponent is the chain.</p>
    </div>
    <div slot="screen-3" class="lesson-content">
      <p class="guiding">Challenge: choose the single-trial reliability needed for an eight-step call to reach 80% end-to-end reliability.</p>
      <div class="control-row" id="pass-k-challenge-controls"></div>
      <div id="pass-k-challenge-visual" class="challenge-chain" aria-live="polite"></div>
      <p id="pass-k-challenge" class="lesson-summary"></p>
    </div>
  </Lesson>
</BaseLayout>
<script>
  import { repeatedSuccess } from "../../lib/lessons/pass-k/model";
  import { slider, wireSlider, svgAxes } from "../../lib/lessons/controls";
  const controls = document.getElementById("pass-k-controls")!;
  controls.innerHTML = slider("pass-k-rate", "Single-step reliability", 50, 100, 90, 1);
  const draw = (rate: number) => {
    const svg = document.getElementById("pass-k-chart")!;
    const values = Array.from({ length: 8 }, (_, i) => repeatedSuccess(rate / 100, i + 1));
    svg.innerHTML = svgAxes(720, 280, "steps", "success") + `<polyline class="plot" points="${values.map((v, i) => `${80 + i * 82},${235 - v * 180}`).join(" ")}"/>` + values.map((v, i) => `<circle class="plot-dot" cx="${80 + i * 82}" cy="${235 - v * 180}" r="6"/><text class="chart-label" x="${75 + i * 82}" y="258">${i + 1}</text>`).join("");
    document.getElementById("pass-k-explore")!.textContent = `${rate}% per step becomes ${(values[7] * 100).toFixed(1)}% across eight steps.`;
  };
  wireSlider("pass-k-rate", draw);
  const challenge = document.getElementById("pass-k-challenge-controls")!;
  challenge.innerHTML = slider("pass-k-target", "Single-step reliability", 80, 100, 97, .1);
  wireSlider("pass-k-target", (value) => {
    const rate = value / 100;
    const result = repeatedSuccess(rate, 8);
    const ok = result >= .8;
    document.getElementById("pass-k-challenge-visual")!.innerHTML = Array.from({ length: 8 }, (_, i) => `<span class="challenge-step ${i < 8 ? (ok ? "ok" : "warn") : ""}">${i + 1}</span>`).join("");
    document.getElementById("pass-k-challenge")!.textContent = `${(result * 100).toFixed(1)}% end-to-end success — ${ok ? "the chain clears 80%." : "the chain misses 80%; raise the per-step bar."}`;
  });
</script>
<style>
  .lesson-content { display: grid; gap: var(--s6); align-content: center; min-height: 25rem; }
  .prompt, .guiding { max-width: 60ch; font-size: 1.2rem; }
  .guiding { color: var(--gold); }
  .mystery-dots, .challenge-chain { display: flex; gap: var(--s3); flex-wrap: wrap; justify-content: center; }
  .mystery-dots span, .challenge-step { display: grid; place-items: center; width: 3rem; height: 3rem; border-radius: 50%; background: var(--green); color: var(--navy); font-family: var(--font-head); font-weight: 700; animation: pulse 1.8s ease-in-out infinite; animation-delay: calc(var(--i) * 120ms); }
  .control-row { max-width: 36rem; }
  .lesson-control { display: grid; gap: var(--s2); color: var(--ink); }
  .lesson-control input { accent-color: var(--cyan); width: 100%; }
  .lesson-control output { color: var(--cyan); font-weight: 700; }
  #pass-k-chart { width: 100%; max-height: 20rem; background: rgba(10,18,36,.5); border-radius: var(--r2); }
  .axis { stroke: var(--panel-edge); stroke-width: 2; } .axis-label, .chart-label { fill: var(--ink-dim); font-size: 14px; } .plot { fill: none; stroke: var(--cyan); stroke-width: 4; } .plot-dot { fill: var(--green); }
  .formula { font-family: ui-monospace, monospace; font-size: clamp(2rem, 8vw, 4rem); color: var(--cyan); text-align: center; } .formula strong { color: var(--green); }
  .challenge-step { background: var(--gold); } .challenge-step.ok { background: var(--green); } .challenge-step.warn { background: var(--gold); }
  .lesson-summary { color: var(--ink-dim); font-size: 1.05rem; margin: 0; }
  @keyframes pulse { 50% { transform: translateY(-5px); box-shadow: 0 0 20px rgba(74,222,128,.35); } }
  @media (prefers-reduced-motion: reduce) { .mystery-dots span { animation: none; } }
</style>
