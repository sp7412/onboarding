---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Lesson from "../../lib/lessons/Lesson.astro";
import { url } from "../../lib/url";

const aha = "A voice agent can generate a complete response while the caller hears only the part before a barge-in.";
const response = "I found your appointment and can move it to Thursday at two PM.";
---

<BaseLayout title="Heard versus generated · Lessons" description={aha}>
  <p class="crumb muted"><a href={url("/lessons")}>Lessons</a> / heard-vs-generated</p>
  <Lesson slug="heard-vs-generated" title="Heard versus generated" aha={aha} related="Lab 03 · turn-taking" time="7 min">
    <div slot="screen-0" class="lesson-content">
      <p class="prompt">The agent has a full answer ready. The caller interrupts halfway through. Which answer did the caller actually receive?</p>
      <div class="speech-stage" aria-label="A voice response interrupted by the caller">
        <div class="speech-bubble generated-bubble"><span class="bubble-label">Agent generated</span>{response}</div>
        <div class="interrupt-mark" aria-hidden="true">caller: “Wait—”</div>
      </div>
      <p class="lesson-summary" aria-live="polite">A complete transcript is not proof of a complete audible answer.</p>
    </div>

    <div slot="screen-1" class="lesson-content">
      <p class="guiding">Move the interruption point. Watch the generated response stay fixed while the heard response stops at a word boundary.</p>
      <div class="control-row" id="heard-controls"></div>
      <div class="comparison" aria-label="Generated and heard response comparison">
        <article class="transcript-card"><h3>Generated</h3><p id="generated-text">{response}</p></article>
        <article class="transcript-card heard-card"><h3>Heard</h3><p id="heard-text"></p></article>
      </div>
      <p id="heard-explore" class="lesson-summary" aria-live="polite"></p>
    </div>

    <div slot="screen-2" class="lesson-content">
      <p class="guiding">The useful distinction is not “what the model wrote.” It is “what crossed the speaker before the caller took the turn.”</p>
      <div class="formula"><span>generated</span> ≠ <strong>heard</strong></div>
      <details class="accessible-summary" open>
        <summary>Accessible summary</summary>
        <p>Generation produces text. Playback exposes that text over time. A barge-in can stop playback before the generated response finishes, so logs and caller experience can disagree.</p>
      </details>
      <p class="lesson-summary">Barge-in is a state transition: stop the old response, then listen and respond to the caller’s new turn.</p>
    </div>

    <div slot="screen-3" class="lesson-content">
      <p class="guiding">Challenge: choose when the caller interrupts, then identify the text the caller heard.</p>
      <div class="control-row" id="heard-challenge-controls"></div>
      <div class="challenge-track" aria-hidden="true"><span id="challenge-progress"></span><i></i></div>
      <p id="heard-challenge" class="lesson-summary" aria-live="polite"></p>
      <details class="accessible-summary"><summary>Accessible summary</summary><p id="heard-challenge-detail"></p></details>
    </div>
  </Lesson>
</BaseLayout>

<script>
  import { playback, playbackSummary } from "../../lib/lessons/heard-vs-generated/model";
  import { slider, wireSlider } from "../../lib/lessons/controls";

  const response = "I found your appointment and can move it to Thursday at two PM.";
  const controls = document.getElementById("heard-controls");
  if (controls) {
    controls.innerHTML = slider("heard-point", "Caller interrupts after word", 1, response.split(" ").length, 7);
    wireSlider("heard-point", (value) => {
      const result = playback(response, value);
      document.getElementById("heard-text")!.textContent = result.heard || "(nothing audible yet)";
      document.getElementById("heard-explore")!.textContent = playbackSummary(result);
    });
  }

  const challenge = document.getElementById("heard-challenge-controls");
  if (challenge) {
    challenge.innerHTML = slider("heard-challenge-point", "Interruption point", 1, response.split(" ").length, 5);
    wireSlider("heard-challenge-point", (value) => {
      const result = playback(response, value);
      const percent = Math.round((value / response.split(" ").length) * 100);
      document.getElementById("challenge-progress")!.style.width = `${percent}%`;
      document.getElementById("heard-challenge")!.textContent = `The caller heard: “${result.heard}”`;
      document.getElementById("heard-challenge-detail")!.textContent = `${playbackSummary(result)} Playback must stop when the caller takes the turn.`;
    });
  }
</script>

<style is:global>
  .lesson-shell :global(.lesson-header) { position: sticky; top: 0; z-index: 4; padding: var(--s3) 0; background: color-mix(in srgb, var(--bg) 92%, transparent); backdrop-filter: blur(12px); }
  .lesson-content { display: grid; gap: var(--s6); align-content: center; min-height: 25rem; }
  .prompt, .guiding { max-width: 62ch; font-size: 1.2rem; }
  .guiding { color: var(--gold); }
  .speech-stage { display: grid; gap: var(--s3); max-width: 48rem; margin: auto; width: 100%; }
  .speech-bubble, .transcript-card { border: 1px solid var(--panel-edge); border-radius: var(--r2); padding: var(--s4); background: rgba(10,18,36,.65); line-height: 1.7; }
  .bubble-label, .transcript-card h3 { display: block; color: var(--cyan); font-family: var(--font-head); font-size: .8rem; letter-spacing: .08em; text-transform: uppercase; margin-bottom: var(--s2); }
  .interrupt-mark { color: var(--gold); font-family: var(--font-head); text-align: right; }
  .control-row { max-width: 40rem; }
  .lesson-control { display: grid; gap: var(--s2); color: var(--ink); }
  .lesson-control input { accent-color: var(--cyan); width: 100%; }
  .lesson-control output { color: var(--cyan); font-weight: 700; }
  .comparison { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s4); }
  .transcript-card p { margin: 0; min-height: 5.5rem; }
  .heard-card { border-color: var(--green); }
  .heard-card h3 { color: var(--green); }
  .formula { font-family: ui-monospace, monospace; font-size: clamp(1.7rem, 7vw, 4rem); color: var(--cyan); text-align: center; }
  .formula strong { color: var(--green); }
  .accessible-summary { border-left: 3px solid var(--gold); padding: var(--s3) var(--s4); color: var(--ink-dim); }
  .accessible-summary summary { color: var(--ink); cursor: pointer; font-family: var(--font-head); font-weight: 700; }
  .accessible-summary p { max-width: 70ch; }
  .lesson-summary { color: var(--ink-dim); font-size: 1.05rem; margin: 0; }
  .challenge-track { position: relative; height: .8rem; border-radius: 99px; background: var(--panel-edge); overflow: hidden; }
  .challenge-track span { display: block; height: 100%; width: 0; background: linear-gradient(90deg, var(--green), var(--cyan)); transition: width .15s ease-out; }
  .challenge-track i { position: absolute; top: 0; right: 0; width: 2px; height: 100%; background: var(--gold); }
  @media (max-width: 600px) { .comparison { grid-template-columns: 1fr; } .lesson-shell :global(.lesson-header) { margin-inline: calc(var(--s4) * -1); padding-inline: var(--s4); } }
  @media (prefers-reduced-motion: reduce) { .challenge-track span { transition: none; } }
</style>
