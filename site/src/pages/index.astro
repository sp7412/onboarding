---
import BaseLayout from "../layouts/BaseLayout.astro";
import { loadContent } from "../lib/content/repo";
import { url } from "../lib/url";

const content = loadContent();
const orderedIds = content.checklistItems.map((item) => item.id);
---

<BaseLayout
  title="Voice AI Engineering Onboarding"
  description="A focused path to understanding, building, evaluating, and operating production voice agents."
>
  <section class="home-intro" aria-labelledby="home-title">
    <p class="eyebrow">VOICE AI ENGINEERING · ONBOARDING</p>
    <h1 id="home-title">Learn the system. Build with confidence.</h1>
    <p class="home-lede">
      A practical guide to the domain, architecture, and engineering practices behind
      production voice agents. Follow the learning path or jump straight to a topic.
    </p>
    <div class="home-actions">
      <a class="btn" href={url("/docs/minimum-path")}>Start the 10-hour learning path <span aria-hidden="true">→</span></a>
      <a class="btn btn-secondary" href={url("/checklist")}>Open the 30/60/90 checklist</a>
      <a class="continue-link" id="continue-btn" href={url("/checklist")} hidden>Continue where you left off →</a>
    </div>
  </section>

  <section class="home-path" aria-labelledby="path-title">
    <div class="section-heading">
      <h2 id="path-title">A clear path forward</h2>
      <a href={url("/checklist")}>View the full checklist →</a>
    </div>
    <ol class="path-list">
      <li>
        <span class="path-number">01</span>
        <div>
          <h3>Understand the domain</h3>
          <p>Learn the contractor workflow, the product, and the customer outcomes that matter.</p>
        </div>
        <a href={url("/reading")}>Start reading <span aria-hidden="true">→</span></a>
      </li>
      <li>
        <span class="path-number">02</span>
        <div>
          <h3>Understand the system</h3>
          <p>Follow a call through speech, orchestration, state, tools, and handoff.</p>
        </div>
        <a href={url("/architecture")}>Explore architecture <span aria-hidden="true">→</span></a>
      </li>
      <li>
        <span class="path-number">03</span>
        <div>
          <h3>Build and evaluate</h3>
          <p>Work through hands-on labs, simulations, traces, and repeatable evaluations.</p>
        </div>
        <a href={url("/labs")}>Open the labs <span aria-hidden="true">→</span></a>
      </li>
      <li>
        <span class="path-number">04</span>
        <div>
          <h3>Prepare for production</h3>
          <p>Develop judgment around reliability, safety, latency, and measurable outcomes.</p>
        </div>
        <a href={url("/docs/first-90-days-playbook")}>Read the playbook <span aria-hidden="true">→</span></a>
      </li>
    </ol>
  </section>

  <section class="home-library" aria-labelledby="library-title">
    <div class="section-heading">
      <h2 id="library-title">Go straight to a topic</h2>
      <div class="library-links"><a href={url("/docs/guide-index")}>Browse all guides →</a><a href={url("/repository-content")}>Browse all repository content →</a></div>
    </div>
    <div class="topic-grid">
      <a class="topic-link" href={url("/reading")}>
        <span class="topic-icon" aria-hidden="true">↗</span>
        <span><strong>Read</strong><small>Ranked readings and technical guides</small></span>
      </a>
      <a class="topic-link" href={url("/labs")}>
        <span class="topic-icon" aria-hidden="true">⌘</span>
        <span><strong>Build</strong><small>Hands-on labs and exercises</small></span>
      </a>
      <a class="topic-link" href={url("/simulations")}>
        <span class="topic-icon" aria-hidden="true">◷</span>
        <span><strong>Evaluate</strong><small>Testing, traces, and release gates</small></span>
      </a>
      <a class="topic-link" href={url("/whitepaper")}>
        <span class="topic-icon" aria-hidden="true">≡</span>
        <span><strong>Reference</strong><small>Whitepaper, glossary, and deeper context</small></span>
      </a>
    </div>
  </section>
</BaseLayout>

<script define:vars={{ orderedIds, checklistUrl: url("/checklist") }}>
  const KEY = "path-to-integration-checklist";
  let saved = {};
  try { saved = JSON.parse(localStorage.getItem(KEY) || "{}"); } catch {}
  const next = orderedIds.find((id) => !saved[id]);
  const btn = document.getElementById("continue-btn");
  if (btn && next && Object.keys(saved).length) {
    btn.setAttribute("href", `${checklistUrl}#${next}`);
    btn.hidden = false;
  }
</script>

<style>
  .home-intro {
    max-width: 790px;
    padding: clamp(2rem, 6vw, 5rem) 0 clamp(2.5rem, 7vw, 5.5rem);
  }
  .eyebrow {
    margin: 0 0 var(--s4);
    color: var(--cyan);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.12em;
  }
  .home-intro h1 {
    max-width: 14ch;
    margin: 0;
    font-size: clamp(2.4rem, 6vw, 4.25rem);
    letter-spacing: -0.045em;
    line-height: 1.08;
  }
  .home-lede {
    max-width: 62ch;
    margin: var(--s6) 0 0;
    color: var(--ink-dim);
    font-size: clamp(1.05rem, 2vw, 1.2rem);
    line-height: 1.7;
  }
  .home-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--s3);
    margin-top: var(--s6);
  }
  .continue-link {
    flex-basis: 100%;
    width: fit-content;
    margin-top: var(--s1);
    font-size: 0.95rem;
  }
  .continue-link[hidden] { display: none; }
  .home-path, .home-library { margin-top: var(--s8); }
  .section-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s4);
    margin-bottom: var(--s4);
  }
  .section-heading h2 {
    margin: 0;
    font-size: clamp(1.35rem, 3vw, 1.7rem);
  }
  .library-links { display: flex; flex-wrap: wrap; gap: var(--s4); }
  .library-links a { font-size: 0.9rem; }
  .section-heading > a {
    flex-shrink: 0;
    font-size: 0.9rem;
  }
  .path-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--panel-edge);
  }
  .path-list li {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--s4);
    padding: var(--s4) 0;
    border-bottom: 1px solid var(--panel-edge);
  }
  .path-number {
    color: var(--ink-dim);
    font-family: var(--font-head);
    font-size: 0.9rem;
    font-variant-numeric: tabular-nums;
  }
  .path-list h3 {
    margin: 0;
    font-size: 1.05rem;
  }
  .path-list p {
    margin: var(--s1) 0 0;
    max-width: 62ch;
    color: var(--ink-dim);
    font-size: 0.93rem;
    line-height: 1.5;
  }
  .path-list li > a {
    font-size: 0.9rem;
    text-align: right;
    white-space: nowrap;
  }
  .topic-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border: 1px solid var(--panel-edge);
    border-radius: var(--r2);
    overflow: hidden;
  }
  .topic-link {
    display: flex;
    align-items: flex-start;
    gap: var(--s3);
    min-width: 0;
    padding: var(--s4);
    color: var(--ink);
    text-decoration: none;
    background: color-mix(in srgb, var(--panel) 40%, transparent);
    transition: background 160ms ease;
  }
  .topic-link + .topic-link { border-left: 1px solid var(--panel-edge); }
  .topic-link:hover { background: var(--panel); }
  .topic-icon {
    display: grid;
    flex: 0 0 34px;
    width: 34px;
    height: 34px;
    place-items: center;
    border: 1px solid var(--panel-edge);
    border-radius: var(--r1);
    color: var(--cyan);
    font-size: 1.15rem;
  }
  .topic-link strong, .topic-link small { display: block; }
  .topic-link strong { font-family: var(--font-head); font-size: 0.98rem; }
  .topic-link small {
    margin-top: var(--s1);
    color: var(--ink-dim);
    font-size: 0.84rem;
    line-height: 1.45;
  }
  @media (max-width: 760px) {
    .topic-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .topic-link:nth-child(3) { border-left: 0; border-top: 1px solid var(--panel-edge); }
    .topic-link:nth-child(4) { border-top: 1px solid var(--panel-edge); }
    .path-list li { grid-template-columns: 32px minmax(0, 1fr); gap: var(--s3); }
    .path-list li > a { grid-column: 2; text-align: left; }
  }
  @media (max-width: 520px) {
    .home-actions { align-items: stretch; flex-direction: column; }
    .home-actions .btn { justify-content: center; text-align: center; }
    .section-heading { align-items: flex-start; flex-direction: column; gap: var(--s2); }
    .topic-grid { grid-template-columns: 1fr; }
    .topic-link + .topic-link { border-left: 0; border-top: 1px solid var(--panel-edge); }
  }
</style>
